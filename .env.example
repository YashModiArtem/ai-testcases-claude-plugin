# Jira MCP Credentials — Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# See docs/CREDENTIALS_SETUP.md for full instructions.

# Jira Data Center host (no https:// prefix)
ATLASSIAN_DOMAIN=your-jira-data-center-host

# Your Atlassian account email (used as identifier in API calls)
ATLASSIAN_EMAIL=your-email@company.com

# Jira Personal Access Token (PAT)
# Generate at: Jira → Profile → Personal Access Tokens
# Use this token for Bearer auth to Jira Data Center
ATLASSIAN_API_TOKEN=your-jira-pat-token

# Disable SSL verification for self-signed/corporate CA certs
# Set to "0" if Jira uses internal/self-signed certificates
NODE_TLS_REJECT_UNAUTHORIZED=0

# Figma API Key — REQUIRED for design review and QA test case generation
# Generate at: https://figma.com/developers
# IMPORTANT: The Figma account that owns this token must have access to the target Figma file
# The Figma account is INDEPENDENT from the Jira account (see below)
# See docs/FIGMA_MCP_SETUP.md for full setup instructions
FIGMA_API_KEY=your-figma-api-key

# Figma account email — for reference only (MCP reads the token, not this field)
# Set this to match the account that owns the FIGMA_API_KEY above
FIGMA_EMAIL=your-figma-account@company.com
