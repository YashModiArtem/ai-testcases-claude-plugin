# Jira MCP Credentials — Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# See docs/CREDENTIALS_SETUP.md for full instructions.

# Jira Data Center host (no https:// prefix)
ATLASSIAN_DOMAIN=your-jira-data-center-host

# Your Atlassian account email (used as identifier in API calls)
ATLASSIAN_EMAIL=your-email@company.com

# Jira Personal Access Token (PAT)
# Generate at: Jira → Profile → Personal Access Tokens
# Use this token for Bearer auth to Jira Data Center
ATLASSIAN_API_TOKEN=your-jira-pat-token

# Disable SSL verification for self-signed/corporate CA certs
# Set to "0" if Jira uses internal/self-signed certificates
NODE_TLS_REJECT_UNAUTHORIZED=0

# Figma API Key — FUTURE (not used today)
# Generate at: figma.com/developers
# Uncomment when Figma integration is enabled
# FIGMA_API_KEY=your-figma-api-key
